/* ---------- Actualización desde Excel (mismo layout: hoja "Base cruda PostHog") ---------- */
const MESES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fmtFechaLarga(iso){ const [y,m,d]=iso.split('-'); return `${+d} ${MESES[+m-1]} ${y}`; }

function normalizeData(){
  DATA.forEach(r=>{
    if(r.tcta==null || String(r.tcta).trim()==='') r.tcta='Sin información';
  });
}

function parseWorkbook(wb){
  const sheetName = wb.SheetNames.find(n=>n.trim().toLowerCase()==='base cruda posthog');
  if(!sheetName) throw new Error('El archivo no contiene la hoja "Base cruda PostHog"');
  const raw = XLSX.utils.sheet_to_json(wb.Sheets[sheetName], {defval:null, raw:true});
  const norm = s=>String(s==null?'':s).trim().toLowerCase();
  const clean = v=>{const s=v==null?'':String(v).trim(); return (s==='N/A'||s==='-'||s==='#N/A')?'':s};
  const out = [];
  raw.forEach(row=>{
    const g = {};
    Object.keys(row).forEach(k=>g[norm(k)]=row[k]);
    const npsRaw = g['nps'];
    if(npsRaw==null || npsRaw==='' || isNaN(+npsRaw)) return;
    const score = Math.round(+npsRaw);
    if(score<0 || score>10) return;
    let f = g['fecha de respuesta'], fecha='';
    if(f instanceof Date){
      fecha = `${f.getUTCFullYear()}-${String(f.getUTCMonth()+1).padStart(2,'0')}-${String(f.getUTCDate()).padStart(2,'0')}`;
    } else if(typeof f==='number' && isFinite(f)){
      const d = new Date(Math.round((f-25569)*86400000));
      fecha = `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')}`;
    } else if(f){
      const s = String(f).trim();
      const mm = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
      fecha = mm ? `${mm[3]}-${mm[2].padStart(2,'0')}-${mm[1].padStart(2,'0')}` : s.slice(0,10);
    }
    const has = (key,tag)=> norm(g[key])===norm(tag) ? 1 : 0;
    const str = (key,dflt)=>{const v=g[key]; const s=v==null?'':String(v).trim(); return s||dflt};
    out.push({
      pais: str('país de respuesta', str('pais de respuesta','Sin información')),
      nav:  str('navegador empleado','Sin información'),
      medio:str('medio de contacto','Sin información'),
      url:  str('url',''),
      cli:  str('cliente','Sin información'),
      nps:  score,
      tipo: str('tipo de evaluador', score<=6?'Detractor':score<=8?'Pasivo':'Promotor'),
      com:  clean(g['comentdetractores'])||clean(g['comentpasivos'])||clean(g['comentpromotores']),
      fecha,
      cya: has('cya','CyA'), dxc: has('dxc','DxC'), eva: has('evaluaciones','Eva'), obj: has('objetivos','Obj'),
      est:  str('estatus actual cliente','-'),
      ae:   str('account executive','-'),
      asp:  str('activation specialist','-'),
      tcta: str('tipo de cuenta','Sin información'),
    });
  });
  return out;
}

function setupDates(){
  const ds = DATA.map(r=>r.fecha).filter(Boolean).sort();
  if(!ds.length) return;
  const min=ds[0], max=ds[ds.length-1];
  ['fDesde','fHasta'].forEach(id=>{const e=document.getElementById(id); e.min=min; e.max=max;});
  document.getElementById('subTitle').textContent =
    `Encuesta in-app (PostHog) · Respuestas del ${fmtFechaLarga(min)} al ${fmtFechaLarga(max)}`;
}

function rebuild(){
  normalizeData();
  FILTERS.forEach(f=>state.sel[f.key]=new Set());
  state.desde=state.hasta=state.com=''; state.page=0;
  state.sortBase={k:'fecha',dir:-1}; state.sortCli={k:'tot',dir:-1};
  document.getElementById('fDesde').value='';
  document.getElementById('fHasta').value='';
  document.getElementById('comSearch').value='';
  buildFilters();
  setupDates();
  refresh();
}

document.getElementById('btnUpload').addEventListener('click',()=>document.getElementById('xlsxInput').click());
document.getElementById('xlsxInput').addEventListener('change', async e=>{
  const file = e.target.files[0]; if(!file) return;
  const st = document.getElementById('dataStatus');
  st.textContent = 'Cargando ' + file.name + '…';
  try{
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf);
    const recs = parseWorkbook(wb);
    if(!recs.length) throw new Error('No se encontraron registros con NPS válido en "Base cruda PostHog"');
    DATA = recs;
    rebuild();
    st.innerHTML = `✓ <b>${file.name}</b> · ${recs.length.toLocaleString('es-MX')} respuestas · actualizado ${new Date().toLocaleString('es-MX')}`;
    st.style.color = 'var(--nps-pro)';
  }catch(err){
    st.textContent = '⚠ ' + (err.message || 'No se pudo leer el archivo');
    st.style.color = 'var(--nps-det)';
  }
  e.target.value = '';
});

rebuild();
</script>
