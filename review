/* ---------- Configuración ---------- */
const C = getComputedStyle(document.documentElement);
const COL = {det:C.getPropertyValue('--nps-det').trim(), pas:C.getPropertyValue('--nps-pas').trim(), pro:C.getPropertyValue('--nps-pro').trim(),
             primary:C.getPropertyValue('--lz-primary').trim(), deep:C.getPropertyValue('--lz-primary-deep').trim(), accent:C.getPropertyValue('--lz-accent').trim()};
Chart.defaults.font.family = "'Inter',sans-serif";
Chart.defaults.color = '#6E6A85';
const segOf = n => n<=6 ? 'Detractor' : (n<=8 ? 'Pasivo' : 'Promotor');
const segColor = s => s==='Detractor'?COL.det : s==='Pasivo'?COL.pas : COL.pro;
const npsColor = v => v<0?COL.det : v<50?COL.pas : COL.pro;
const fmt = n => n.toLocaleString('es-MX');
const fmtNps = v => (Math.round(v*10)/10).toLocaleString('es-MX');

/* ---------- Filtros ---------- */
const FILTERS = [
  {key:'pais',  label:'País'},
  {key:'medio', label:'Medio de contacto'},
  {key:'nav',   label:'Navegador'},
  {key:'cli',   label:'Cliente', search:true},
  {key:'url',   label:'URL', search:true},
  {key:'nps',   label:'NPS (0–10)', numeric:true},
  {key:'tipo',  label:'Tipo de evaluador'},
  {key:'prod',  label:'Productos', virtual:true, options:[['cya','CyA'],['dxc','DxC'],['eva','Evaluaciones'],['obj','Objetivos']]},
  {key:'tcta',  label:'Tipo de cuenta'},
  {key:'est',   label:'Estatus cliente'},
  {key:'ae',    label:'Account Executive'},
  {key:'asp',   label:'Activation Specialist'},
];
const state = {sel:{}, desde:'', hasta:'', com:'', sortBase:{k:'fecha',dir:-1}, sortCli:{k:'tot',dir:-1}, page:0, min10:true};
FILTERS.forEach(f=>state.sel[f.key]=new Set());

function buildFilters(){
  const cont = document.getElementById('msContainer');
  cont.innerHTML = '';
  FILTERS.forEach(f=>{
    let opts;
    if(f.virtual){ opts = f.options.map(([k,l])=>[l, DATA.filter(r=>r[k]===1).length, k]); }
    else {
      const m = new Map();
      DATA.forEach(r=>{const v=String(r[f.key]); m.set(v,(m.get(v)||0)+1)});
      opts = [...m.entries()].sort((a,b)=> f.numeric ? (+a[0])-(+b[0]) : b[1]-a[1]).map(([v,n])=>[v,n,v]);
    }
    const ms = document.createElement('div'); ms.className='ms'; ms.dataset.key=f.key;
    ms.innerHTML = `<button type="button"><span>${f.label}</span></button>
      <div class="panel">
        ${f.search?'<input type="search" placeholder="Buscar…">':''}
        <div class="acts"><button type="button" class="all">Todos</button><button type="button" class="none">Ninguno</button></div>
        <div class="opts">${opts.map(([lab,n,val])=>`<label class="opt" data-t="${String(lab).toLowerCase()}"><input type="checkbox" value="${String(val).replace(/"/g,'&quot;')}"><span>${lab}</span><span class="n">${fmt(n)}</span></label>`).join('')}</div>
      </div>`;
    cont.appendChild(ms);
    const btn = ms.querySelector(':scope>button');
    btn.addEventListener('click',e=>{e.stopPropagation(); document.querySelectorAll('.ms.open').forEach(x=>{if(x!==ms)x.classList.remove('open')}); ms.classList.toggle('open')});
    ms.querySelector('.panel').addEventListener('click',e=>e.stopPropagation());
    ms.querySelectorAll('.opts input').forEach(ch=>ch.addEventListener('change',()=>{
      ch.checked ? state.sel[f.key].add(ch.value) : state.sel[f.key].delete(ch.value); refresh();
    }));
    ms.querySelector('.all').addEventListener('click',()=>{ms.querySelectorAll('.opts input').forEach(ch=>{ch.checked=true;state.sel[f.key].add(ch.value)});refresh()});
    ms.querySelector('.none').addEventListener('click',()=>{ms.querySelectorAll('.opts input').forEach(ch=>ch.checked=false);state.sel[f.key].clear();refresh()});
    const s = ms.querySelector('input[type=search]');
    if(s) s.addEventListener('input',()=>{const q=s.value.toLowerCase(); ms.querySelectorAll('.opt').forEach(o=>o.style.display=o.dataset.t.includes(q)?'flex':'none')});
  });
  if(!window._msCloseBound){
    document.addEventListener('click',()=>document.querySelectorAll('.ms.open').forEach(x=>x.classList.remove('open')));
    window._msCloseBound = true;
  }
}

function passes(r){
  for(const f of FILTERS){
    const sel = state.sel[f.key]; if(!sel.size) continue;
    if(f.virtual){ let ok=false; for(const k of sel) if(r[k]===1){ok=true;break} if(!ok) return false; }
    else if(!sel.has(String(r[f.key]))) return false;
  }
  if(state.desde && r.fecha < state.desde) return false;
  if(state.hasta && r.fecha > state.hasta) return false;
  if(state.com && !(r.com||'').toLowerCase().includes(state.com)) return false;
  return true;
}
const filtered = ()=>DATA.filter(passes);

function nps(rows){
  if(!rows.length) return {nps:0,pro:0,pas:0,det:0,n:0};
  let pro=0,pas=0,det=0;
  rows.forEach(r=>{const s=segOf(r.nps); s==='Promotor'?pro++:s==='Pasivo'?pas++:det++});
  return {nps:(pro-det)/rows.length*100, pro,pas,det, n:rows.length};
}
function groupNps(rows,key){
  const m=new Map();
  rows.forEach(r=>{const k=String(r[key]); if(!m.has(k))m.set(k,[]); m.get(k).push(r)});
  return [...m.entries()].map(([k,v])=>({k,...nps(v)}));
}

/* ---------- Charts ---------- */
let charts={};
function mk(id,cfg){ if(charts[id]) charts[id].destroy(); charts[id]=new Chart(document.getElementById(id),cfg); }
const npsLabelPlugin = {
  id:'npsLabel',
  afterDatasetsDraw(c,_,o){
    if(!o.items) return;
    const {ctx}=c, meta=c.getDatasetMeta(c.data.datasets.length-1);
    ctx.save(); ctx.font="700 11px 'Sora',sans-serif"; ctx.fillStyle=COL.deep; ctx.textBaseline='middle';
    o.items.forEach((it,i)=>{const el=meta.data[i]; if(!el)return; ctx.fillText('NPS '+fmtNps(it), Math.min(el.x+8, c.chartArea.right-58), el.y)});
    ctx.restore();
  }
};
Chart.register(npsLabelPlugin);

function stacked100(id, groups, sortBy='n'){
  groups.sort((a,b)=>b[sortBy]-a[sortBy]);
  const labels = groups.map(g=>`${g.k} (${fmt(g.n)})`);
  mk(id,{type:'bar',
    data:{labels,datasets:[
      {label:'Detractores',data:groups.map(g=>g.det/g.n*100),backgroundColor:COL.det,stack:'s'},
      {label:'Pasivos',data:groups.map(g=>g.pas/g.n*100),backgroundColor:COL.pas,stack:'s'},
      {label:'Promotores',data:groups.map(g=>g.pro/g.n*100),backgroundColor:COL.pro,stack:'s'},
    ]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{boxWidth:11,font:{size:11}}},
        npsLabel:{items:groups.map(g=>g.nps)},
        tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmtNps(c.raw)}%`}}},
      scales:{x:{stacked:true,max:100,ticks:{callback:v=>v+'%'},grid:{color:'#EFEAFA'}},y:{stacked:true,grid:{display:false},ticks:{font:{size:11}}}}}
  });
}
function hbarNps(id, groups, height){
  groups.sort((a,b)=>b.nps-a.nps);
  mk(id,{type:'bar',
    data:{labels:groups.map(g=>`${g.k} (${fmt(g.n)})`),
      datasets:[{data:groups.map(g=>Math.round(g.nps*10)/10),backgroundColor:groups.map(g=>npsColor(g.nps)),borderRadius:5,maxBarThickness:22}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>{const g=groups[c.dataIndex];return [`NPS: ${fmtNps(g.nps)}`,`Base: ${fmt(g.n)} · P ${g.pro} / Pa ${g.pas} / D ${g.det}`]}}}},
      scales:{x:{min:-100,max:100,grid:{color:'#EFEAFA'}},y:{grid:{display:false},ticks:{font:{size:11},autoSkip:false}}}}
  });
}

function refresh(){
  const rows = filtered();
  const T = nps(rows);
  /* badges + KPIs */
  document.getElementById('hbNps').textContent = fmtNps(T.nps);
  document.getElementById('hbBase').textContent = fmt(T.n);
  document.getElementById('kNps').textContent = fmtNps(T.nps);
  document.getElementById('kNps').style.color = npsColor(T.nps);
  document.getElementById('kNpsSub').textContent = '%Promotores − %Detractores';
  document.getElementById('kBase').textContent = fmt(T.n);
  document.getElementById('kBaseSub').textContent = `de ${fmt(DATA.length)} respuestas totales`;
  document.getElementById('kPro').textContent = fmt(T.pro);
  document.getElementById('kPas').textContent = fmt(T.pas);
  document.getElementById('kDet').textContent = fmt(T.det);
  const p=x=>T.n?fmtNps(x/T.n*100)+'% de la base':'—';
  document.getElementById('kProPct').textContent=p(T.pro);
  document.getElementById('kPasPct').textContent=p(T.pas);
  document.getElementById('kDetPct').textContent=p(T.det);
  const nf = FILTERS.reduce((a,f)=>a+(state.sel[f.key].size?1:0),0)+(state.desde||state.hasta?1:0)+(state.com?1:0);
  document.getElementById('activeInfo').innerHTML = nf? `<b>${nf}</b> filtro(s) activo(s) · <b>${fmt(T.n)}</b> registros` : `Sin filtros · <b>${fmt(T.n)}</b> registros`;
  document.querySelectorAll('.ms').forEach(ms=>{
    const k=ms.dataset.key,n=state.sel[k].size,b=ms.querySelector(':scope>button');
    b.classList.toggle('on',n>0);
    b.innerHTML=`<span>${FILTERS.find(f=>f.key===k).label}</span>`+(n?` <span class="count">${n}</span>`:'');
  });

  /* Donut */
  mk('chDonut',{type:'doughnut',
    data:{labels:[`Promotores (${fmt(T.pro)})`,`Pasivos (${fmt(T.pas)})`,`Detractores (${fmt(T.det)})`],
      datasets:[{data:[T.pro,T.pas,T.det],backgroundColor:[COL.pro,COL.pas,COL.det],borderWidth:3,borderColor:'#fff'}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'62%',
      plugins:{legend:{position:'bottom',labels:{boxWidth:12,font:{size:12}}},
        tooltip:{callbacks:{label:c=>` ${c.label}: ${T.n?fmtNps(c.raw/T.n*100):0}%`}}}}
  });
  /* Distribución 0–10 */
  const dist = Array(11).fill(0); rows.forEach(r=>dist[r.nps]++);
  mk('chDist',{type:'bar',
    data:{labels:[...Array(11).keys()],datasets:[{data:dist,backgroundColor:dist.map((_,i)=>segColor(segOf(i))),borderRadius:6}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
      scales:{x:{grid:{display:false}},y:{grid:{color:'#EFEAFA'},beginAtZero:true}}}
  });
  /* Tendencia diaria */
  const byDate = groupNps(rows,'fecha').sort((a,b)=>a.k<b.k?-1:1);
  mk('chTrend',{
    data:{labels:byDate.map(g=>g.k.slice(5)),datasets:[
      {type:'bar',label:'Detractores',data:byDate.map(g=>g.det),backgroundColor:COL.det,stack:'s',order:2},
      {type:'bar',label:'Pasivos',data:byDate.map(g=>g.pas),backgroundColor:COL.pas,stack:'s',order:2},
      {type:'bar',label:'Promotores',data:byDate.map(g=>g.pro),backgroundColor:COL.pro,stack:'s',order:2,borderRadius:4},
      {type:'line',label:'NPS del día',data:byDate.map(g=>Math.round(g.nps*10)/10),borderColor:COL.deep,backgroundColor:COL.deep,yAxisID:'y2',tension:.35,pointRadius:4,order:1}
    ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{boxWidth:11,font:{size:11}}}},
      scales:{x:{stacked:true,grid:{display:false}},y:{stacked:true,grid:{color:'#EFEAFA'},title:{display:true,text:'Respuestas'}},
        y2:{position:'right',min:-100,max:100,grid:{display:false},title:{display:true,text:'NPS'}}}}
  });
  /* Composición por dimensión */
  stacked100('chMedio',groupNps(rows,'medio'));
  stacked100('chNav',groupNps(rows,'nav').filter(g=>g.n>0));
  stacked100('chPais',groupNps(rows,'pais').slice(0,12));

  /* ----- Cálculos ----- */
  hbarNps('ccMedio',groupNps(rows,'medio'));
  hbarNps('ccNav',groupNps(rows,'nav'));
  hbarNps('ccPais',groupNps(rows,'pais'));
  let gc = groupNps(rows,'cli');
  if(state.min10) gc = gc.filter(g=>g.n>=10);
  hbarNps('ccCli',gc.slice(0,30));
  renderTblCli(rows);
  state.page=0; renderTblBase(rows);
  window._rows = rows;
}

/* ---------- Tabla base ---------- */
const PAGE=25;
function renderTblBase(rows){
  const {k,dir}=state.sortBase;
  const sorted=[...rows].sort((a,b)=>{const x=a[k],y=b[k];return (x<y?-1:x>y?1:0)*dir});
  const tot=sorted.length, pages=Math.max(1,Math.ceil(tot/PAGE));
  state.page=Math.min(state.page,pages-1);
  const slice=sorted.slice(state.page*PAGE,(state.page+1)*PAGE);
  const tb=document.querySelector('#tblBase tbody');
  tb.innerHTML=slice.map(r=>{
    const s=segOf(r.nps), cls=s==='Detractor'?'det':s==='Pasivo'?'pas':'pro';
    const prods=[r.cya&&'CyA',r.dxc&&'DxC',r.eva&&'Eva',r.obj&&'Obj'].filter(Boolean).map(p=>`<span class="prodtag">${p}</span>`).join('')||'<span style="color:#bbb">—</span>';
    return `<tr><td>${r.fecha}</td><td><b>${r.cli}</b><div class="note" style="margin:0">${r.url}</div></td>
      <td><span class="npsval" style="color:${segColor(s)}">${r.nps}</span></td>
      <td><span class="pill ${cls}">${s}</span></td><td>${r.pais}</td><td>${r.medio}</td><td>${r.nav}</td><td>${r.est}</td>
      <td>${prods}</td><td style="max-width:340px">${r.com?r.com:'<span style="color:#bbb">—</span>'}</td></tr>`;
  }).join('');
  document.getElementById('pgInfo').textContent=`${tot?state.page*PAGE+1:0}–${Math.min((state.page+1)*PAGE,tot)} de ${fmt(tot)}`;
  document.getElementById('pgPrev').disabled=state.page===0;
  document.getElementById('pgNext').disabled=state.page>=pages-1;
}
document.getElementById('pgPrev').addEventListener('click',()=>{state.page--;renderTblBase(window._rows)});
document.getElementById('pgNext').addEventListener('click',()=>{state.page++;renderTblBase(window._rows)});
document.querySelectorAll('#tblBase thead th[data-k]').forEach(th=>th.addEventListener('click',()=>{
  const k=th.dataset.k;
  state.sortBase.dir = state.sortBase.k===k ? -state.sortBase.dir : -1; state.sortBase.k=k;
  document.querySelectorAll('#tblBase .arr').forEach(a=>a.textContent='');
  th.querySelector('.arr').textContent=state.sortBase.dir===1?'▲':'▼';
  renderTblBase(window._rows);
}));

/* ---------- Tabla clientes (Cálculos) ---------- */
function renderTblCli(rows){
  let g = groupNps(rows,'cli').map(x=>({cli:x.k,pro:x.pro,pas:x.pas,det:x.det,tot:x.n,nps:x.nps}));
  if(state.min10==='table-only') g=g; /* la tabla muestra todos */
  const prodByCli={};
  rows.forEach(r=>{prodByCli[r.cli]=[r.cya&&'CyA',r.dxc&&'DxC',r.eva&&'Eva',r.obj&&'Obj'].filter(Boolean)});
  const {k,dir}=state.sortCli;
  g.sort((a,b)=>{const x=a[k],y=b[k];return (x<y?-1:x>y?1:0)*dir});
  document.querySelector('#tblCli tbody').innerHTML=g.map(r=>{
    const prods=(prodByCli[r.cli]||[]).map(p=>`<span class="prodtag">${p}</span>`).join('')||'<span style="color:#bbb">—</span>';
    return `<tr><td><b>${r.cli}</b></td>
      <td style="color:${COL.pro};font-weight:700">${r.pro||''}</td>
      <td style="color:#9a7b00;font-weight:700">${r.pas||''}</td>
      <td style="color:${COL.det};font-weight:700">${r.det||''}</td>
      <td>${r.tot}</td>
      <td><span class="npsval" style="color:${npsColor(r.nps)}">${fmtNps(r.nps)}</span></td>
      <td>${prods}</td></tr>`;
  }).join('');
}
document.querySelectorAll('#tblCli thead th[data-k]').forEach(th=>th.addEventListener('click',()=>{
  const k=th.dataset.k;
  state.sortCli.dir = state.sortCli.k===k ? -state.sortCli.dir : -1; state.sortCli.k=k;
  document.querySelectorAll('#tblCli .arr').forEach(a=>a.textContent='');
  th.querySelector('.arr').textContent=state.sortCli.dir===1?'▲':'▼';
  renderTblCli(window._rows);
}));

